# Laisser vide pour utiliser automatiquement une instance MongoDB locale
# en memoire (mongodb-memory-server) - pratique pour le developpement.
# Renseigner une vraie URI (MongoDB Atlas, etc.) pour la production.
MONGODB_URI=

PORT=4000
CLIENT_URL=http://localhost:5173

JWT_SECRET=change-this-to-a-long-random-string
ADMIN_JWT_SECRET=change-this-to-a-different-long-random-string

# Identifiants admin crees par le script de seed (npm run seed)
ADMIN_EMAIL=admin@pizzadelivery.example
ADMIN_PASSWORD=admin1234

# SMTP pour les emails (verification de compte, reinitialisation de mot de passe,
# alertes de stock bas). Laisser vide en dev pour utiliser un compte de test
# Ethereal genere automatiquement (les emails sont captures, jamais vraiment envoyes).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Pizza Delivery <no-reply@pizzadelivery.example>

# Cle API Razorpay en mode TEST (https://dashboard.razorpay.com/app/keys).
# Laisser vide pour utiliser le mode simulation (bouton "Simuler le paiement").
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Seuil de stock (en portions) sous lequel une alerte email est envoyee a l'admin
LOW_STOCK_THRESHOLD=5
